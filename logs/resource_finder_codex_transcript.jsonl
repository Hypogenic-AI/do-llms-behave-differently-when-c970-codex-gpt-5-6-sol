{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"pwd && mkdir -p datasets/samples && source .venv/bin/activate && python - <<'PY'\nfrom datasets import load_from_disk\nfrom pathlib import Path\nimport csv,json,collections\nw=load_from_disk('datasets/wildchat_5k')\nlangs=collections.Counter(w['language']); models=collections.Counter(w['model'])\nprint('WildChat rows',w.num_rows,'languages',langs.most_common(10),'models',models.most_common(10),'toxic',sum(bool(x) for x in w['toxic']),'redacted',sum(bool(x) for x in w['redacted']))\n# sanitized example: omit IP, location, headers, moderation fields, and assistant content\nsamples=[]\nfor row in w:\n    user=next((m.get('content','') for m in row['conversation'] if m.get('role')=='user'), '')\n    if row['redacted'] or row['toxic'] or not user or len(user)>800: continue\n    samples.append({'model':row['model'],'language':row['language'],'turn':row['turn'],'user_prompt':user})\n    if len(samples)==5: break\nPath('datasets/samples/wildchat_sanitized_examples.json').write_text(json.dumps(samples,indent=2,ensure_ascii=False)+'\\\\n')\nfor fn in ['benign-behaviors.csv','harmful-behaviors.csv']:\n with Path('datasets/jbb_behaviors/data',fn).open(newline='') as f: rows=list(csv.DictReader(f))\n print(fn,len(rows),collections.Counter(r['Category'] for r in rows))\n Path('datasets/samples',fn).write_text('\\\\n'.join([','.join(rows[0].keys()),*(','.join(json.dumps(v) if ',' in v else v for v in r.values()) for r in rows[:5])])+'\\\\n')\nroot=Path('datasets/anthropic_model_written_evals'); files=list(root.rglob('*.jsonl')); total=0; groups=collections.Counter()\nfor p in files:\n n=sum(1 for line in p.open() if line.strip()); total+=n; groups[p.relative_to(root).parts[0]]+=n\nprint('Anthropic JSONL files',len(files),'records',total,'groups',groups)\nsel=root/'advanced-ai-risk/lm_generated_evals/self-awareness-text-model.jsonl'\nwith sel.open() as f: a=[json.loads(next(f)) for _ in range(5)]\nPath('datasets/samples/anthropic_self_awareness_examples.json').write_text(json.dumps(a,indent=2)+'\\\\n')\nPY\npwd && du -h datasets/samples/* && sed -n '1,180p' datasets/jbb_behaviors/README.md && sed -n '1,180p' datasets/anthropic_model_written_evals/README.md && sed -n '1,180p' datasets/anthropic_model_written_evals/sycophancy/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
